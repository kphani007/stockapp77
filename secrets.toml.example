# Rename to secrets.toml (do NOT commit real values) OR paste these in
# Streamlit Cloud -> Manage app -> Settings -> Secrets.

# --- Dhan live OI (optional) ---
# Get both from Dhan Web -> Profile -> DhanHQ Trading APIs (token is valid 24h;
# use an API-key/long-lived setup if you want it to persist).
DHAN_CLIENT_ID = "your_client_id"
DHAN_ACCESS_TOKEN = "your_access_token"

# --- AI Analyst (optional) ---
# Both are required to switch the AI Analyst on. The access code is what you type
# in the app to unlock it; without one the feature stays off, so visitors to a
# public deployment cannot spend your API key.
ANTHROPIC_API_KEY = "sk-ant-..."
AGENT_ACCESS_CODE = "choose-a-long-random-code"
# AGENT_MODEL = "claude-sonnet-5-5"   # optional override; check current model ids
# AGENT_WEB_SEARCH = "0"              # optional: turn web search off
# AGENT_MAX_TURNS = "40"              # optional: AI requests allowed per session
